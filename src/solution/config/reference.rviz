Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 2
      Plane Cell Count: 20
      Reference Frame: map
      Offset: {X: 0, Y: 0, Z: 0}
      Color: 90; 90; 90
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
      Alpha: 0.8
      Color Scheme: map
    - Class: rviz_default_plugins/MarkerArray
      Name: Reference
      Enabled: true
      Topic:
        Value: /reference/markers
    - Class: rviz_default_plugins/Path
      Name: Path
      Enabled: true
      Topic:
        Value: /reference/path
      Color: 30; 120; 255
      Line Style: Billboards
      Line Width: 0.05
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 255; 40; 40
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Show Arrows: false
      Marker Scale: 1.0
      Frames:
        All Enabled: false
        base_link:
          Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: false
      Topic:
        Value: /odom
  Global Options:
    Fixed Frame: map
    Background Color: 40; 40; 40
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 28
      X: 0
      Y: 0
      Target Frame: base_link
Window Geometry:
  Width: 1100
  Height: 850
